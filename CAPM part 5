static void viewSchedule() {
        String[] days = {
            "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
        System.out.println("\n--- Weekly Schedule ---");
        System.out.println("0 = Free, 1 = Booked");
        for (int i = 0; i < doctorSchedule.length; i++) {
            System.out.print(days[i] + ": ");
            for (int j = 0; j < doctorSchedule[i].length; j++) {
                System.out.print(doctorSchedule[i][j] + " ");
            }
            System.out.println();
        }
    }static void addPatientRecord(Scanner sc) {
        if (patientCount >= patientNames.length) {
            System.out.println("Database is full!");
            return;
        }
        System.out.print("Enter Patient Name: ");
        patientNames[patientCount] = sc.nextLine();
        System.out.print("Enter Patient Age: ");
        patientAges[patientCount] = sc.nextInt();
        sc.nextLine();
        System.out.println("Patient Record Saved!");
        System.out.println("Patient Index: " + patientCount);
        patientCount++;
    }
}
